# --- API ColisConsult (NestJS) ---
PORT=4000
DATABASE_URL=postgresql://colisconsult:colisconsult@localhost:5432/colisconsult

# Origines autorisées à appeler l'API depuis le navigateur (séparées par des virgules)
WEB_ORIGIN=http://localhost:3000

# Secret de signature des sessions admin : générer une valeur longue et aléatoire
# ex. node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h

# Premier compte admin, créé par `npm run db:seed`
ADMIN_EMAIL=admin@colisconsult.com
ADMIN_PASSWORD=change-me-now
ADMIN_NAME=Équipe ColisConsult

# Dossier de stockage des factures déposées (hors du dossier public)
UPLOAD_DIR=./storage/uploads
UPLOAD_MAX_FILE_MB=15

# Notifications e-mail des nouvelles demandes (optionnel : sans SMTP_HOST, les e-mails sont seulement journalisés)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ColisConsult <noreply@colisconsult.com>"
NOTIFY_EMAIL=commercial@colisconsult.com
