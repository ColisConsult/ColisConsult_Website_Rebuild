# --- Site ColisConsult (Next.js) ---
# URL publique du site (balises canoniques, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# API appelée par le serveur Next.js (rendu des pages, back-office) : adresse de base,
# sans /api. Sur Vercel, ne pas la définir : la liaison (binding) du service web l'injecte.
API_SERVICE_URL=http://localhost:4000
# Facultatif : API joignable pendant `next build` (ex. https://www.colisconsult.com),
# pour pré-rendre les pages avec le contenu réel
# API_BUILD_URL=
# API appelée par le navigateur (formulaires, simulateur). Sur Vercel, ne pas la définir :
# « /api » sur le même domaine est utilisé par défaut.
NEXT_PUBLIC_API_URL=http://localhost:4000/api
