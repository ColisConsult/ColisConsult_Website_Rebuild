{
  "name": "colisconsult",
  "private": true,
  "version": "1.0.0",
  "description": "Site ColisConsult — Next.js (web) + NestJS (api) + PostgreSQL",
  "workspaces": [
    "apps/*"
  ],
  "packageManager": "npm@11.21.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "npm run start:dev -w api",
    "dev:web": "npm run dev -w web",
    "build": "npm run build -w api && npm run build -w web",
    "db:up": "docker compose up -d db",
    "db:migrate": "npm run db:migrate -w api",
    "db:seed": "npm run db:seed -w api",
    "import:wordpress": "npm run import:wordpress -w api",
    "test": "npm test -w api",
    "lint": "npm run lint -w api && npm run lint -w web"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@swc/core@1.16.18": true,
    "unrs-resolver@1.12.2": true,
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true
  }
}
